@charset "utf-8";

:root { --bg: #0f0f10; --s1: #161618; --s2: #1e1e21; --s3: #29292d; --line: #2c2c31; --or: #ff4d12; --or-hi: #ff7a47; --or-lo: #a8300a; --or-bg: rgba(255, 77, 18, .12); --tx: #f3f3f4; --mt: #a3a3ab; --wrap: 1360px; --gut: 24px; --r: 12px; --ff: 'Mitr', 'Tahoma', sans-serif; }

*, ::before, ::after { box-sizing: border-box; }

[hidden] { display: none !important; }

html { scroll-behavior: smooth; text-size-adjust: 100%; scroll-padding-top: 12px; }

body { margin: 0px; background: var(--bg); color: var(--tx); font: 300 16px/1.7 var(--ff); overflow-x: hidden; }

body.au-lock { overflow: hidden; }

img { max-width: 100%; height: auto; display: block; }

a { color: inherit; text-decoration: none; }

a:hover { color: var(--or-hi); }

button { font: inherit; color: inherit; cursor: pointer; }

h1, h2, h3 { margin: 0px; font-weight: 500; line-height: 1.35; }

b, strong { font-weight: 500; }

ul, ol { margin: 0px; padding: 0px; list-style: none; }

:focus-visible { outline: 2px solid var(--or-hi); outline-offset: 2px; }

::selection { background: var(--or); color: rgb(255, 255, 255); }

.au-wrap { width: 100%; max-width: var(--wrap); margin: 0px auto; padding: 0 var(--gut); }

.au-sr { width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; position: absolute !important; }

.au-skip { position: absolute; left: 12px; top: -60px; z-index: 100; padding: 8px 16px; border-radius: 8px; background: var(--or); color: rgb(255, 255, 255); }

.au-skip:focus { top: 12px; color: rgb(255, 255, 255); }

.au-main { display: block; min-height: 50vh; padding-bottom: 10px; }

.au-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0px 22px; border: 0px; border-radius: 999px; background: var(--or); color: rgb(255, 255, 255); font: 500 15px/1 var(--ff); transition: background 0.2s, transform 0.2s; }

.au-btn:hover { background: var(--or-hi); color: rgb(255, 255, 255); }

.au-btn:active { transform: scale(0.97); }

.au-btn--ghost { background: rgba(255, 255, 255, 0.1); color: var(--tx); }

.au-btn--ghost:hover { background: rgba(255, 255, 255, 0.18); color: rgb(255, 255, 255); }

.au-all { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; height: 34px; padding: 0px 14px; border: 1px solid var(--or-lo); border-radius: 8px; background: var(--or-bg); color: var(--or-hi); font-size: 14px; font-weight: 400; white-space: nowrap; }

.au-all i { font-size: 11px; }

.au-all:hover { background: var(--or); border-color: var(--or); color: rgb(255, 255, 255); }

.au-ibtn { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 10px; background: var(--s2); color: var(--tx); font-size: 17px; }

.au-ibtn:hover, .au-ibtn[aria-expanded="true"] { border-color: var(--or); color: var(--or-hi); }

.au-pill { display: inline-flex; align-items: center; padding: 3px 12px; border-radius: 8px; background: var(--or); color: rgb(255, 255, 255); font-size: 0.72em; font-weight: 600; letter-spacing: 0.04em; vertical-align: middle; }

.au-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; font: 500 12px/1.5 var(--ff); white-space: nowrap; }

.au-badge--score { background: var(--or); color: rgb(255, 255, 255); }

.au-badge--score i { font-size: 10px; }

.au-badge--q { background: rgba(20, 20, 22, 0.82); color: rgb(230, 230, 234); border: 1px solid rgba(255, 255, 255, 0.22); }

.au-top { position: relative; z-index: 40; background: var(--bg); border-bottom: 1px solid var(--line); }

.au-top__row { display: flex; align-items: center; gap: 22px; min-height: 72px; }

.au-logo { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; line-height: 1; white-space: nowrap; color: var(--tx); }

.au-logo b { padding: 6px 9px 7px; border-radius: 8px; background: var(--or); color: rgb(255, 255, 255); font-weight: 600; font-size: 21px; transform: skewX(-8deg); }

.au-logo span { font-size: 23px; font-weight: 600; letter-spacing: 0.02em; }

.au-logo:hover { color: var(--tx); }

.au-logo:hover b { background: var(--or-hi); }

.au-nav ul { display: flex; align-items: center; gap: 2px; }

.au-nav a { display: block; padding: 8px 12px; border-radius: 8px; color: var(--mt); font-size: 15px; font-weight: 400; white-space: nowrap; }

.au-nav a:hover { color: var(--tx); background: var(--s2); }

.au-nav a.is-on, .au-nav .current-menu-item > a { color: rgb(255, 255, 255); background: var(--or-bg); box-shadow: inset 0 -2px 0 var(--or); }

.au-find { position: relative; display: flex; align-items: center; flex: 1 1 0%; min-width: 0px; max-width: 380px; margin-left: auto; height: 44px; border: 1px solid var(--line); border-radius: 999px; background: var(--s1); }

.au-find:focus-within { border-color: var(--or); }

.au-find input { flex: 1 1 0%; min-width: 0px; height: 100%; padding: 0px 0px 0px 18px; border: 0px; background: transparent; color: var(--tx); font: 300 15px var(--ff); outline: 0px; }

.au-find input::placeholder { color: rgb(117, 117, 125); }

.au-find__go { display: grid; place-items: center; flex: 0 0 auto; width: 36px; height: 36px; margin-right: 4px; border: 0px; border-radius: 50%; background: var(--or); color: rgb(255, 255, 255); font-size: 14px; }

.au-find__go:hover { background: var(--or-hi); }

.au-find__out { position: absolute; z-index: 60; left: 0px; right: 0px; top: calc(100% + 8px); min-width: 300px; max-height: 70vh; overflow-y: auto; padding: 6px; border: 1px solid var(--line); border-radius: var(--r); background: var(--s1); box-shadow: rgba(0, 0, 0, 0.6) 0px 20px 50px; }

