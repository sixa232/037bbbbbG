:root { --bg: #0f0f10; --s1: #161618; --s2: #1e1e21; --s3: #29292d; --line: #2c2c31; --or: #ff4d12; --or-hi: #ff7a47; --or-lo: #a8300a; --or-bg: rgba(255, 77, 18, .12); --tx: #f3f3f4; --mt: #a3a3ab; --wrap: 1360px; --gut: 24px; --r: 12px; --ff: 'Mitr', 'Tahoma', sans-serif; }

*, ::before, ::after { box-sizing: border-box; }

[hidden] { display: none !important; }

html { scroll-behavior: smooth; text-size-adjust: 100%; scroll-padding-top: 12px; }

body { margin: 0px; background: var(--bg); color: var(--tx); font: 300 16px/1.7 var(--ff); overflow-x: hidden; }

body.au-lock { overflow: hidden; }

img { max-width: 100%; height: auto; display: block; }

a { color: inherit; text-decoration: none; }

a:hover { color: var(--or-hi); }

button { font: inherit; color: inherit; cursor: pointer; }

h1, h2, h3 { margin: 0px; font-weight: 500; line-height: 1.35; }

b, strong { font-weight: 500; }

ul, ol { margin: 0px; padding: 0px; list-style: none; }

:focus-visible { outline: 2px solid var(--or-hi); outline-offset: 2px; }

::selection { background: var(--or); color: rgb(255, 255, 255); }

.au-wrap { width: 100%; max-width: var(--wrap); margin: 0px auto; padding: 0 var(--gut); }

.au-sr { width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; position: absolute !important; }

.au-skip { position: absolute; left: 12px; top: -60px; z-index: 100; padding: 8px 16px; border-radius: 8px; background: var(--or); color: rgb(255, 255, 255); }

.au-skip:focus { top: 12px; color: rgb(255, 255, 255); }

.au-main { display: block; min-height: 50vh; padding-bottom: 10px; }

.au-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0px 22px; border: 0px; border-radius: 999px; background: var(--or); color: rgb(255, 255, 255); font: 500 15px/1 var(--ff); transition: background 0.2s, transform 0.2s; }

.au-btn:hover { background: var(--or-hi); color: rgb(255, 255, 255); }

.au-btn:active { transform: scale(0.97); }

.au-btn--ghost { background: rgba(255, 255, 255, 0.1); color: var(--tx); }

.au-btn--ghost:hover { background: rgba(255, 255, 255, 0.18); color: rgb(255, 255, 255); }

.au-all { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; height: 34px; padding: 0px 14px; border: 1px solid var(--or-lo); border-radius: 8px; background: var(--or-bg); color: var(--or-hi); font-size: 14px; font-weight: 400; white-space: nowrap; }

.au-all i { font-size: 11px; }

.au-all:hover { background: var(--or); border-color: var(--or); color: rgb(255, 255, 255); }

.au-ibtn { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 10px; background: var(--s2); color: var(--tx); font-size: 17px; }

.au-ibtn:hover, .au-ibtn[aria-expanded="true"] { border-color: var(--or); color: var(--or-hi); }

.au-pill { display: inline-flex; align-items: center; padding: 3px 12px; border-radius: 8px; background: var(--or); color: rgb(255, 255, 255); font-size: 0.72em; font-weight: 600; letter-spacing: 0.04em; vertical-align: middle; }

.au-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; font: 500 12px/1.5 var(--ff); white-space: nowrap; }

.au-badge--score { background: var(--or); color: rgb(255, 255, 255); }

.au-badge--score i { font-size: 10px; }

.au-badge--q { background: rgba(20, 20, 22, 0.82); color: rgb(230, 230, 234); border: 1px solid rgba(255, 255, 255, 0.22); }

.au-top { position: relative; z-index: 40; background: var(--bg); border-bottom: 1px solid var(--line); }

.au-top__row { display: flex; align-items: center; gap: 22px; min-height: 72px; }

.au-logo { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; line-height: 1; white-space: nowrap; color: var(--tx); }

.au-logo b { padding: 6px 9px 7px; border-radius: 8px; background: var(--or); color: rgb(255, 255, 255); font-weight: 600; font-size: 21px; transform: skewX(-8deg); }

.au-logo span { font-size: 23px; font-weight: 600; letter-spacing: 0.02em; }

.au-logo:hover { color: var(--tx); }

.au-logo:hover b { background: var(--or-hi); }

.au-nav ul { display: flex; align-items: center; gap: 2px; }

.au-nav a { display: block; padding: 8px 12px; border-radius: 8px; color: var(--mt); font-size: 15px; font-weight: 400; white-space: nowrap; }

.au-nav a:hover { color: var(--tx); background: var(--s2); }

.au-nav a.is-on, .au-nav .current-menu-item > a { color: rgb(255, 255, 255); background: var(--or-bg); box-shadow: inset 0 -2px 0 var(--or); }

.au-find { position: relative; display: flex; align-items: center; flex: 1 1 0%; min-width: 0px; max-width: 380px; margin-left: auto; height: 44px; border: 1px solid var(--line); border-radius: 999px; background: var(--s1); }

.au-find:focus-within { border-color: var(--or); }

.au-find input { flex: 1 1 0%; min-width: 0px; height: 100%; padding: 0px 0px 0px 18px; border: 0px; background: transparent; color: var(--tx); font: 300 15px var(--ff); outline: 0px; }

.au-find input::placeholder { color: rgb(117, 117, 125); }

.au-find__go { display: grid; place-items: center; flex: 0 0 auto; width: 36px; height: 36px; margin-right: 4px; border: 0px; border-radius: 50%; background: var(--or); color: rgb(255, 255, 255); font-size: 14px; }

.au-find__go:hover { background: var(--or-hi); }

.au-find__out { position: absolute; z-index: 60; left: 0px; right: 0px; top: calc(100% + 8px); min-width: 300px; max-height: 70vh; overflow-y: auto; padding: 6px; border: 1px solid var(--line); border-radius: var(--r); background: var(--s1); box-shadow: rgba(0, 0, 0, 0.6) 0px 20px 50px; }

.au-find__i { display: grid; grid-template-columns: 40px minmax(0px, 1fr); gap: 12px; align-items: center; padding: 6px 8px; border-radius: 8px; }

.au-find__i:hover, .au-find__i:focus-visible { background: var(--s2); color: var(--tx); }

.au-find__i img, .au-find__ph { width: 40px; height: 60px; object-fit: cover; border-radius: 6px; background: var(--s3); }

.au-find__i b { display: block; font-size: 14px; line-height: 1.45; }

.au-find__i small { color: var(--mt); font-size: 12px; }

.au-find__all { display: block; margin-top: 4px; padding: 10px; border-radius: 8px; background: var(--or-bg); color: var(--or-hi); text-align: center; font-weight: 400; }

.au-find__none { margin: 0px; padding: 14px; color: var(--mt); }

.au-top__act { display: flex; gap: 8px; flex: 0 0 auto; }

.au-ibtn--find { display: none; }

.au-shade { position: fixed; inset: 0px; z-index: 70; background: rgba(0, 0, 0, 0.7); }

.au-mega { position: fixed; z-index: 71; top: 0px; right: 0px; bottom: 0px; width: min(420px, 100%); overflow-y: auto; overscroll-behavior: contain; padding: 0px 20px 28px; background: var(--s1); border-left: 1px solid var(--line); animation: 0.25s ease-out 0s 1 normal none running au-in; }

.au-mega__head { position: sticky; top: 0px; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin: 0px -20px 14px; padding: 14px 20px; background: var(--s1); border-bottom: 1px solid var(--line); }

.au-mega__quick { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 8px; margin-bottom: 8px; }

.au-mega__quick a { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px; background: var(--s2); font-weight: 400; font-size: 15px; }

.au-mega__quick i { color: var(--or); width: 16px; text-align: center; }

.au-mega__quick a:hover { background: var(--s3); color: var(--tx); }

.au-mega__h { display: flex; justify-content: space-between; align-items: baseline; margin: 20px 0px 10px; font-size: 16px; font-weight: 500; }

.au-mega__h a { color: var(--or-hi); font-size: 13px; font-weight: 300; }

.au-mega__pills { display: flex; flex-wrap: wrap; gap: 8px; }

.au-mega__pills a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--s2); color: rgb(214, 214, 220); font-size: 14px; }

.au-mega__pills small { color: var(--mt); font-size: 11px; }

.au-mega__pills a:hover { border-color: var(--or); color: rgb(255, 255, 255); }

.au-mega__pills a.is-on { background: var(--or); border-color: var(--or); color: rgb(255, 255, 255); }

.au-mega__pills a.is-on small { color: rgb(255, 225, 212); }

@keyframes au-in { 
  0% { transform: translateX(30px); opacity: 0; }
  100% { transform: none; opacity: 1; }
}

.au-sh { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; margin: 0px 0px 18px; }

.au-sh__t { position: relative; padding-left: 14px; font-size: clamp(20px, 2vw, 24px); font-weight: 500; }

.au-sh__t::before { content: ""; position: absolute; left: 0px; top: 0.28em; bottom: 0.28em; width: 4px; border-radius: 4px; background: var(--or); }

.au-sh .au-all { margin-left: auto; }

.au-sh .au-band__nav + .au-all { margin-left: 0px; }

.au-sh--tools { align-items: center; }

.au-sort { display: flex; flex-wrap: wrap; gap: 6px; margin-left: auto; padding: 4px; border-radius: 999px; background: var(--s1); border: 1px solid var(--line); }

.au-sort__i { padding: 5px 14px; border-radius: 999px; color: var(--mt); font-size: 14px; }

.au-sort__i:hover { color: var(--tx); }

.au-sort__i.is-on { background: var(--or); color: rgb(255, 255, 255); }

.au-hero { padding-top: 22px; }

.au-hero__box { position: relative; overflow: hidden; border-radius: 18px; background: var(--s1); aspect-ratio: 1300 / 520; min-height: 360px; }

.au-hero__slide { position: absolute; inset: 0px; }

.au-hero__slide.is-in { animation: 0.45s ease-out 0s 1 normal none running au-fade; }

.au-hero__bg { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }

.au-hero__slide::after { content: ""; position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(15, 15, 16, 0.95) 0%, rgba(15, 15, 16, 0.7) 38%, rgba(15, 15, 16, 0.05) 70%), linear-gradient(0deg, rgba(15, 15, 16, 0.85) 0%, transparent 45%); }

.au-hero__txt { position: absolute; z-index: 1; left: 48px; bottom: 64px; width: min(560px, 55%); }

.au-hero__tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin: 0px 0px 12px; color: rgb(214, 214, 220); font-size: 14px; }

.au-hero__t { margin: 0px; font-size: clamp(26px, 3vw, 42px); font-weight: 600; line-height: 1.25; }

.au-hero__t a:hover { color: rgb(255, 255, 255); }

.au-hero__kind { margin: 6px 0px 0px; color: var(--or-hi); font-size: 14px; }

.au-hero__syn { max-height: 3.4em; overflow: hidden; margin: 10px 0px 0px; color: rgb(200, 200, 206); font-size: 15px; }

.au-hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0px 0px; }

.au-hero__ctl { position: absolute; z-index: 2; right: 26px; bottom: 22px; display: flex; align-items: center; gap: 12px; }

.au-hero__arrow { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 50%; background: rgba(15, 15, 16, 0.6); color: rgb(255, 255, 255); }

.au-hero__arrow:hover { background: var(--or); border-color: var(--or); }

.au-hero__dots { display: flex; gap: 6px; }

.au-hero__dots button { width: 10px; height: 10px; padding: 0px; border: 0px; border-radius: 999px; background: rgba(255, 255, 255, 0.35); transition: width 0.25s, background 0.25s; }

.au-hero__dots button[aria-pressed="true"] { width: 28px; background: var(--or); }

@keyframes au-fade { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.au-top10 { margin-top: 40px; }

.au-top10__track { grid-auto-columns: calc(20% - 14.4px) !important; gap: 18px !important; }

.au-top10__i { scroll-snap-align: start; min-width: 0px; }

.au-top10__i a { position: relative; display: flex; align-items: flex-end; padding-left: 26%; }

.au-top10__n { position: absolute; left: -4px; bottom: -14px; z-index: 0; font-variant-ligatures: ; font-variant-caps: ; font-variant-numeric: ; font-variant-east-asian: ; font-variant-alternates: ; font-variant-position: ; font-variant-emoji: ; font-weight: ; font-stretch: ; font-size: ; line-height: ; font-family: ; font-optical-sizing: ; font-size-adjust: ; font-kerning: ; font-feature-settings: ; font-variation-settings: ; font-language-override: ; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 3px var(--or); paint-order: stroke; font-style: italic; }

.au-top10__pic { position: relative; z-index: 1; display: block; width: 100%; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 10px; background: var(--s2); box-shadow: rgba(0, 0, 0, 0.6) -10px 0px 22px; }

.au-top10__pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }

.au-top10__info { position: absolute; left: 0px; right: 0px; bottom: 0px; padding: 30px 10px 10px; background: linear-gradient(0deg, rgba(10, 10, 11, 0.95), transparent); }

.au-top10__t { display: block; max-height: 1.5em; overflow: hidden; font-size: 14px; font-weight: 500; line-height: 1.5; color: rgb(255, 255, 255); }

.au-top10__b { display: flex; gap: 6px; margin-top: 6px; }

.au-top10__i a:hover img { transform: scale(1.05); }

.au-top10__i a:hover .au-top10__n { -webkit-text-stroke-color: var(--or-hi); }

.au-cats { margin-top: 44px; }

